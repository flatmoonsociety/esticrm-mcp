# Skopiuj ten plik jako .env i uzupełnij własne dane z EstiCRM.
# Nigdy nie dodawaj pliku .env do repozytorium.
ESTICRM_COMPANY_ID=wpisz_id_firmy
ESTICRM_API_TOKEN=wpisz_token_api

# Narzędzia zapisujące dane pozostają wyłączone, dopóki jawnie nie zmienisz wartości.
ESTICRM_ENABLE_WRITES=false

# Opcjonalne ustawienia. Wartości poniżej są domyślne.
ESTICRM_TIMEOUT_MS=15000
ESTICRM_REQUEST_INTERVAL_MS=1100

# Maksymalny rozmiar pojedynczej odpowiedzi. Domyślnie: 2097152 bajty (2 MiB).
ESTICRM_MAX_RESPONSE_BYTES=2097152

# Maksymalna liczba równocześnie trwających i oczekujących operacji. Domyślnie: 25.
ESTICRM_MAX_ACTIVE_REQUESTS=25
