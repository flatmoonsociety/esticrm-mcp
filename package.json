{
  "name": "esticrm-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Nieoficjalny lokalny serwer MCP dla API EstiCRM z polskimi narzędziami.",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "bin": {
    "esticrm-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "pnpm build",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/test-mcp.mjs",
    "sprawdz": "pnpm typecheck && pnpm test && pnpm build && pnpm smoke",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flatmoonsociety/esticrm-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/flatmoonsociety/esticrm-mcp/issues"
  },
  "homepage": "https://github.com/flatmoonsociety/esticrm-mcp#readme",
  "keywords": [
    "esticrm",
    "mcp",
    "model-context-protocol",
    "nieruchomosci",
    "crm",
    "polska"
  ],
  "author": "flatmoonsociety",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "26.5.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
